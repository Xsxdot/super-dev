{
  "productName": "SuperDev",
  "version": "0.2.4",
  "identifier": "dev.superdev.app",
  "build": {
    "beforeDevCommand": "bash scripts/build-agent.sh --remote-install && pnpm dev",
    "beforeBuildCommand": "bash scripts/build-agent.sh --remote-install && pnpm build",
    "devUrl": "http://localhost:6688",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SuperDev",
        "width": 1200,
        "height": 750,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 19 }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/superdev-agent",
      "binaries/superdev-mcp",
      "binaries/superdev-sample"
    ],
    "resources": {
      "resources/agent-install/": "agent-install/",
      "resources/js-debug/": "js-debug/",
      "resources/skills/": "skills/"
    }
  }
}
