    {
      "id": "code-health-after",
      "tool": "diagnose_service",
      "coverage": "supporting",
      "_comment": "PID 相同只证明进程未替换；再通过正式 diagnose_service 聚合运行态和日志，证明恢复后的受管服务没有处于失败状态。",
      "arguments": {
        "project_name": "{{go_project_name}}",
        "deployment_id": "{{go_deployment_id}}"
      },
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.data.target.deployment.id",
            "operator": "eq",
            "variable": "go_deployment_id"
          },
          {
            "path": "structuredContent.data.status",
            "operator": "eq",
            "value": "running"
          },
          {
            "path": "structuredContent.data.runtime_summary.pid",
            "operator": "eq",
            "variable": "code_runtime_pid_before"
          }
        ]
      },
      "evidence": {
        "record": [
          "structuredContent.summary",
          "structuredContent.data.target.deployment.id",
          "structuredContent.data.status",
          "structuredContent.data.runtime_summary.pid",
          "structuredContent.data.evidence",
          "structuredContent.data.hints"
        ],
        "redact": [
          "structuredContent.data.target.deployment.env",
          "structuredContent.data.runtime_summary.env"
        ],
        "forbid": [
          "authorization",
          "cookie",
          "approval_token",
          "bearer ",
          "password=",
          "secret="
        ]
      }
    }
  ],
  "cleanup": [
    {
      "id": "code-clear-breakpoints",
      "tool": "set_debug_breakpoints",
      "coverage": "supporting",
      "run_if": "variable_set:code_debug_session_id&&primary_step_not_passed:code-clear-breakpoints-before-pause",
      "_comment": "setBreakpoints 是按 source 全量替换，空数组才是不会留下未来暂停点的精确清理。",
      "arguments": {
        "deployment_id": "{{go_deployment_id}}",
        "source": "{{go_source_path}}",
        "lines": []
      },
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.ok",
            "operator": "eq",
            "value": true
          }
        ]
      },
      "evidence": {
        "record": [
          "structuredContent.summary",
          "structuredContent.data.result.deployment_id",
          "structuredContent.data.result.lease_created",
          "structuredContent.data.result.resolved_source",
          "structuredContent.data.result.breakpoints"
        ],
        "redact": [],
        "forbid": [
          "authorization",
          "cookie",
          "approval_token"
        ]
      }
    },
    {
      "id": "code-resume-on-abort",
      "tool": "debug_continue",
      "coverage": "supporting",
      "run_if": "variable_set:code_debug_session_id&&primary_step_not_passed:code-continue-final",
      "arguments": {
        "deployment_id": "{{go_deployment_id}}",
        "thread_id": "{{code_thread_id}}"
      },
      "settle_ms": 500,
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.data.result.action",
            "operator": "eq",
            "value": "continue"
          }
        ]
      },
      "evidence": {
        "record": [
          "structuredContent.summary",
          "structuredContent.data.result.deployment_id",
          "structuredContent.data.result.session_id",
          "structuredContent.data.result.action",
          "structuredContent.data.result.thread_id"
        ],
        "redact": [],
        "forbid": [
          "authorization",
          "cookie",
          "approval_token"
        ]
      }
    },
    {
      "id": "stop-go-after-code",
      "tool": "stop_service",
      "coverage": "supporting",
      "run_if": "variable_set:project_id",
      "arguments": {
        "project_id": "{{project_id}}",
        "deployment_id": "{{go_deployment_id}}",
        "approval_wait_seconds": 300
      },
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.data.action",
            "operator": "eq",
            "value": "stop"
          }
        ]
      },
      "evidence": {
        "record": [
          "structuredContent.data.target",
          "structuredContent.data.action"
        ],
        "redact": [],
        "forbid": [
          "approval_token"
        ]
      }
    },
    {
      "id": "wait-go-stopped-after-code",
      "tool": "diagnose_service",
      "coverage": "supporting",
      "run_if": "variable_set:project_id",
      "arguments": {
        "project_id": "{{project_id}}",
        "deployment_id": "{{go_deployment_id}}"
      },
      "poll": {
        "interval_ms": 1000,
        "timeout_ms": 60000
      },
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.data.target.deployment.id",
            "operator": "eq",
            "variable": "go_deployment_id"
          },
          {
            "path": "structuredContent.data.status",
            "operator": "eq",
            "value": "stopped"
          }
        ]
      },
      "evidence": {
        "record": [
          "structuredContent.data.target.deployment.id",
          "structuredContent.data.status",
          "structuredContent.data.runtime_summary.pid"
        ],
        "redact": [],
        "forbid": []
      }
    }
  ]
}
