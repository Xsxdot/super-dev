    {
      "id": "code-continue-final",
      "tool": "debug_continue",
      "coverage": "primary",
      "_comment": "主路径最后一次 continue 是无暂停残留的直接证明；失败或超时时 cleanup 会再做 supporting continue。",
      "arguments": {
        "deployment_id": "{{go_deployment_id}}",
        "thread_id": "{{code_thread_id}}"
      },
      "settle_ms": 500,
      "expect": {
        "outcome": "success",
        "assertions": [
          {
            "path": "structuredContent.data.result.action",
