{
  "responsibility": "Describe the Node.js Fixture Protocol v1 process, provider configuration, readiness and debug anchor.",
  "boundary": "This descriptor contributes provider evidence only and owns zero MCP tool verdict rows.",
  "schema_version": 1,
  "kind": "superdev.windows-validation.fixture",
  "id": "node",
  "contract_version": "v1",
  "provider": "node",
  "cwd": "fixtures/node",
  "build": {
    "windows_command": "build.cmd",
    "prerequisites": ["node 24.18.0", "npm 11.16.0"],
    "windows_entry": "build.cmd",
    "working_directory": ".",
    "success_exit_code": 0
  },
  "run": {
    "windows_command": "run.cmd",
    "port": 18171,
    "windows_entry": "run.cmd",
    "working_directory": ".",
    "default_port": 18171,
    "clean_stop": ["CTRL_C", "CTRL_BREAK"]
  },
  "readiness": {
    "url": "http://127.0.0.1:18171/healthz",
    "status": 200,
    "method": "GET",
    "path": "/healthz",
    "expected_status": 200,
    "expected_fields": {"ready": true, "contract_version": "v1", "provider": "node"}
  },
  "probe": {
    "method": "POST",
    "path": "/api/probe",
    "authentication": "bearer_campaign_id",
    "normal_status": 200,
    "controlled_error_status": 500
  },
  "language_runtime": {
    "cwd": ".",
    "config": {"program": "src/server.js"}
  },
  "runtime": {
    "config": {"program": "src/server.js"},
    "env": {"FIXTURE_PORT": "18171", "FIXTURE_CAMPAIGN_ID": "{{campaign_id}}"}
  },
  "debug": {
    "strategy": "prearm-listen",
    "adapter": "node",
    "preflight": ["preflight.cmd", "debug"],
    "source": "src/server.js",
    "line": 50,
    "variables": ["fixtureMarker", "fixtureCount", "fixtureProvider"],
    "prerequisites": ["packaged js-debug 1.117.0", "Node inspector prearm"],
    "marker": "SUPERDEV_FIXTURE_BREAKPOINT",
    "expected_non_secret_variables": {"fixtureMarker": "breakpoint-visible", "fixtureCount": 42, "fixtureProvider": "node"},
    "external_prerequisite": "Packaged js-debug 1.117.0 under SUPERDEV_AGENT_DATA_DIR"
  },
  "prerequisites": [
    {"name": "node", "version": "24.18.0", "required_for": ["build", "run", "debug"]},
    {"name": "npm", "version": "11.16.0", "required_for": ["build"]},
    {"name": "packaged-js-debug", "version": "1.117.0", "required_for": ["debug"], "missing_verdict": "BLOCKED_OR_PRODUCT_PACKAGING_DEFECT"}
  ],
  "contract": {
    "normal_path": "/api/probe",
    "error_path": "/api/probe",
    "auth_header": "Authorization",
    "auth_value_env": "FIXTURE_CAMPAIGN_ID",
    "auth_scheme": "bearer_campaign_id",
    "authorization_template": "Bearer superdev-validation-{campaign_id}"
  },
  "coverage": {"provider_report": true, "mcp_tool_rows": []}
}
