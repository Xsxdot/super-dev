.superpowers/
.worktrees/

# OS metadata
.DS_Store

# Dependencies
node_modules/
.pnpm-store/

# Build and test outputs
dist/
coverage/
artifacts/
# The Windows validation package consumes these immutable pipeline fixtures as
# source inputs; hiding them makes clean-clone validation non-reproducible.
!validation/windows-real/pipeline/artifacts/
!validation/windows-real/pipeline/artifacts/**
# Cross-platform strict bundles consume the same immutable A/B fixtures.
!validation/runtime/pipeline/artifacts/
!validation/runtime/pipeline/artifacts/**
*.profraw
*.profdata
desktop/dist/
desktop/src-tauri/target/

# Local environment files
.env
.env.*

# Local tooling
.claude/
.playwright-mcp/
AGENTS.md
agents.md

# Manual UI test captures
screenshot-*.png
!docs/assets/readme/screenshot-*.png
superdev-product-audit/

# Local/internal planning notes (not product source)
design-qa.md
docs/model-redesign.md
docs/superpowers/
specs/

# Local markdown issue tracker
.scratch/

# Private business/strategy docs (not for the open-source repo)
docs/MONETIZATION.md

# Generated remote agent install artifacts
desktop/src-tauri/resources/agent-install/superdev-agent-*
desktop/src-tauri/resources/js-debug/*
!desktop/src-tauri/resources/js-debug/.gitkeep

# Local bundled desktop binaries
desktop/src-tauri/binaries/superdev-*-aarch64-apple-darwin
